@keyframes dot-loader {
    0% {
        transform: scale(0.6);
        opacity: 0.7;
    }
    50% {
        transform: scale(1.1);
        opacity: 1;
    }
    100% {
        transform: scale(0.6);
        opacity: 0.7;
    }
}
.sm_msg.sm_reply .dot-loader {
